APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Vivona

# Local PostgreSQL Database Connections (Least-Privilege Roles)
DATABASE_URL=postgres://vivona_app:ChangeMe_App#2026@127.0.0.1:5432/vivona
DATABASE_AUTH_URL=postgres://vivona_auth:ChangeMe_Auth#2026@127.0.0.1:5432/vivona
DATABASE_SERVICE_URL=postgres://vivona_service:ChangeMe_Service#2026@127.0.0.1:5432/vivona
DATABASE_OWNER_URL=postgres://vivona_owner:ChangeMe_Owner#2026@127.0.0.1:5432/vivona

# Cryptographic Keys (Generated via pnpm keys:gen)
DATA_ENCRYPTION_KEY=        # 32 bytes AES-256-GCM key, base64
BLIND_INDEX_KEY=            # 32 bytes HMAC-SHA256 key, base64
FILE_ENCRYPTION_KEY=        # 32 bytes AES-256-GCM key, base64
BACKUP_KEY=                 # 32 bytes AES-256-GCM key, base64
AUTH_RSA_PRIVATE_KEY=       # 3072-bit RSA Private Key PEM, base64 (Server only)
AUTH_RSA_PUBLIC_KEY=        # 3072-bit RSA Public Key PEM, base64

# Google OAuth 2.0 (Client Sign-In & Staff Link)
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=               # From Google Cloud Console Credentials
GOOGLE_CLIENT_SECRET=           # From Google Cloud Console Credentials (Server only)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# External integrations (optional)
RESEND_API_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CRON_SECRET=

# Demo & Environment Flags
DEMO_MODE=false
DEMO_PASSWORD=ChangeMe-Demo#2026
